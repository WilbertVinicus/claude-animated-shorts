// src/CartoonShort/CameraRig.tsx
// Câmeras deslizantes: um movimento para cada uma das 7 cenas, definido em dados.
// Usa: react, remotion (useCurrentFrame), three, @react-three/fiber (useThree) e config.ts.

import React from "react";
import { useCurrentFrame } from "remotion";
import { useThree } from "@react-three/fiber";
import * as THREE from "three";
import type { CameraMove } from "./config";

type Vec3 = [number, number, number];

export type CameraPose = {
      position: Vec3;
        lookAt: Vec3;
          fov: number;
};

// ---------- Matemática dos movimentos ----------

type Ease = "linear" | "inOut" | "out";

type MoveDef = {
      /** Poses por onde a câmera passa. 2 poses = reta; 3 ou mais = curva suave. */
        keys: CameraPose[];
          ease: Ease;
};

const clamp01 = (v: number): number => Math.min(1, Math.max(0, v));

const lerp = (a: number, b: number, u: number): number => a + (b - a) * u;

const applyEase = (ease: Ease, t: number): number => {
      const x = clamp01(t);
        if (ease === "linear") return x;
          if (ease === "out") return 1 - Math.pow(1 - x, 3);
            return -(Math.cos(Math.PI * x) - 1) / 2;
};

const catmullRom = (
      p0: number,
        p1: number,
          p2: number,
            p3: number,
              u: number
): number =>
  0.5 *
    (2 * p1 +
        (-p0 + p2) * u +
            (2 * p0 - 5 * p1 + 4 * p2 - p3) * u * u +
                (-p0 + 3 * p1 - 3 * p2 + p3) * u * u * u);

                /** Lê values[i] como número (seguro mesmo com noUncheckedIndexedAccess ligado). */
                const at = (values: number[], i: number): number => values[i] as number;

                /** Percorre uma lista de valores: 2 valores = reta; 3 ou mais = curva suave. */
                const sampleValues = (values: number[], p: number): number => {
                      const n = values.length;
                        if (n === 1) return at(values, 0);
                          const s = p * (n - 1);
                            const i = Math.min(n - 2, Math.floor(s));
                              const u = s - i;
                                if (n === 2) return lerp(at(values, 0), at(values, 1), u);
                                  const p0 = at(values, Math.max(i - 1, 0));
                                    const p1 = at(values, i);
                                      const p2 = at(values, i + 1);
                                        const p3 = at(values, Math.min(i + 2, n - 1));
                                          return catmullRom(p0, p1, p2, p3, u);
                };

                const sampleVec3 = (points: Vec3[], p: number): Vec3 => [
                      sampleValues(
                            points.map((v) => v[0]),
                                p
                      ),
                        sampleValues(
                                points.map((v) => v[1]),
                                    p
                        ),
                          sampleValues(
                                points.map((v) => v[2]),
                                    p
                          ),
                ];

                const samplePose = (keys: CameraPose[], p: number): CameraPose => ({
                      position: sampleVec3(
                            keys.map((k) => k.position),
                                p
                      ),
                        lookAt: sampleVec3(
                                keys.map((k) => k.lookAt),
                                    p
                        ),
                          fov: sampleValues(
                                keys.map((k) => k.fov),
                                    p
                          ),
                });

                const makePose = (position: Vec3, lookAt: Vec3, fov = 50): CameraPose => ({
                      position,
                        lookAt,
                          fov,
                });

                // ---------- Os movimentos (todos, menos a órbita da cena 4) ----------
                // Coordenadas seguem o mapa do World.tsx: rio em z de -16 a 0,
                // Parlamento em x de -34 a 2 (fachada em z = -22,5), rua em z positivo.

                const MOVES: Record<Exclude<CameraMove, "orbita-mesa">, MoveDef> = {
                      // 1. Gancho: desce do céu até o rio fedido.
                        "descida-ceu-rio": {
                                ease: "inOut",
                                    keys: [
                                              makePose([8, 52, 36], [-4, 6, -16], 52),
                                                    makePose([5, 24, 30], [-5, 5, -16], 52),
                                                          makePose([2, 6.5, 21], [-6, 4.5, -16], 55),
                                    ],
                        },

                          // 2. Causa: panorâmica lateral pela margem, olhando os canos de esgoto.
                            "panoramica-margem": {
                                    ease: "inOut",
                                        keys: [
                                                  makePose([-26, 4.5, 12], [-26, -0.2, -15], 50),
                                                        makePose([26, 4.5, 12], [26, -0.2, -15], 50),
                                        ],
                            },

                              // 3. Parlamento: zoom no prédio e depois nos deputados.
                                "zoom-parlamento": {
                                        ease: "inOut",
                                            keys: [
                                                      makePose([-8, 10, 14], [-12, 6, -27], 52),
                                                            makePose([-12, 6.5, -2], [-13, 5, -25], 48),
                                                                  makePose([-13.5, 3.2, -11], [-14, 2.2, -19], 46),
                                            ],
                                },

                                  // 5. Obra: travelling lateral, em velocidade constante (ver travellingX).
                                    "travelling-marcha": {
                                            ease: "linear",
                                                keys: [
                                                          makePose([-24, 2.4, 15.5], [-19, 1.7, 6], 50),
                                                                makePose([20, 2.4, 15.5], [25, 1.7, 6], 50),
                                                ],
                                    },

                                      // 6. Resultado: guindaste, sobe e abre o plano.
                                        "guindaste-abre": {
                                                ease: "inOut",
                                                    keys: [
                                                              makePose([-4, 3, 14], [0, 2.2, 0], 50),
                                                                    makePose([2, 12, 28], [0, 3, -10], 54),
                                                                          makePose([8, 30, 46], [0, 4, -16], 58),
                                                    ],
                                        },

                                          // 7. Twist: da Londres moderna até o bueiro.
                                            "zoom-bueiro": {
                                                    ease: "inOut",
                                                        keys: [
                                                                  makePose([16, 15, 40], [4, 7, -12], 54),
                                                                        makePose([7, 9, 24], [1, 2, 4], 50),
                                                                              makePose([0.5, 6.5, 14], [0, 0.2, 8], 44),
                                                        ],
                                            },
                };

                // ---------- Órbita da cena 4 (a câmera gira em volta da mesa) ----------

                /** Dados da órbita. O Scenes.tsx usa orbitAngleAt() para girar os personagens junto. */
                export const ORBIT: {
                      center: Vec3;
                        radius: number;
                          startAngle: number;
                            endAngle: number;
                              startHeight: number;
                                endHeight: number;
                                  fov: number;
                } = {
                      center: [0, 1.8, 8],
                        radius: 9,
                          startAngle: -0.55,
                            endAngle: 0.55,
                              startHeight: 3.6,
                                endHeight: 5,
                                  fov: 46,
                };

                /** Ângulo da câmera (radianos) na órbita. Use como `yaw` dos BeanCharacter. */
                export const orbitAngleAt = (t: number): number =>
                  lerp(ORBIT.startAngle, ORBIT.endAngle, applyEase("inOut", t));

                  // ---------- Travelling da cena 5 ----------

                  export const TRAVELLING_START_X = -22;
                  export const TRAVELLING_END_X = 22;

                  /** Posição X de quem marcha, sincronizada com a câmera do travelling (t de 0 a 1). */
                  export const travellingX = (t: number): number =>
                    lerp(TRAVELLING_START_X, TRAVELLING_END_X, clamp01(t));

                    // ---------- Pose da câmera ----------

                    /** Pose da câmera para um movimento, com t de 0 (início da cena) a 1 (fim). */
                    export const getCameraPose = (move: CameraMove, t: number): CameraPose => {
                          if (move === "orbita-mesa") {
                                const cx = ORBIT.center[0];
                                    const cy = ORBIT.center[1];
                                        const cz = ORBIT.center[2];
                                            const a = orbitAngleAt(t);
                                                const height = lerp(
                                                          ORBIT.startHeight,
                                                                ORBIT.endHeight,
                                                                      applyEase("inOut", t)
                                                );
                                                    return {
                                                              position: [
                                                                        cx + Math.sin(a) * ORBIT.radius,
                                                                                height,
                                                                                        cz + Math.cos(a) * ORBIT.radius,
                                                              ],
                                                                    lookAt: [cx, cy, cz],
                                                                          fov: ORBIT.fov,
                                                    };
                          }
                            const def = MOVES[move];
                              return samplePose(def.keys, applyEase(def.ease, t));
                    };

                    // ---------- Componente ----------

                    export type CameraRigProps = {
                          move: CameraMove;
                            /** Duração da cena em frames (use getSceneDuration do config.ts). */
                              durationInFrames: number;
                                /** Deslocamento extra aplicado à posição e ao alvo da câmera. */
                                  offset?: Vec3;
                    };

                    /**
                     * Coloque dentro do <ThreeCanvas>, dentro da <Sequence> da cena.
                      * Muda a câmera durante o render, de propósito: é o jeito de mantê-la
                       * sincronizada com o frame do Remotion (o useFrame do r3f não é).
                        */
                        export const CameraRig: React.FC<CameraRigProps> = ({
                              move,
                                durationInFrames,
                                  offset = [0, 0, 0],
                        }) => {
                              const frame = useCurrentFrame();
                                const camera = useThree((state) => state.camera);
                                  const invalidate = useThree((state) => state.invalidate);

                                    const t = durationInFrames > 1 ? clamp01(frame / (durationInFrames - 1)) : 0;
                                      const pose = getCameraPose(move, t);

                                        camera.position.set(
                                                pose.position[0] + offset[0],
                                                    pose.position[1] + offset[1],
                                                        pose.position[2] + offset[2]
                                        );
                                          camera.lookAt(
                                                pose.lookAt[0] + offset[0],
                                                    pose.lookAt[1] + offset[1],
                                                        pose.lookAt[2] + offset[2]
                                          );
                                            if (camera instanceof THREE.PerspectiveCamera && camera.fov !== pose.fov) {
                                                    camera.fov = pose.fov;
                                                        camera.updateProjectionMatrix();
                                            }
                                              // Pede um novo desenho, mesmo que nada mais na cena tenha mudado neste frame.
                                                invalidate();

                                                  return null;
                        };
                                                    }
                        }
                      )
                ]
)
}